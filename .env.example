# 环境变量覆盖示例：复制为 .env 或直接导出
DATACENTER_SERVER_PORT=8080
DATACENTER_SERVER_MODE=debug
DATACENTER_DATABASE_URI=mongodb://localhost:27017
DATACENTER_DATABASE_NAME=datacenter
DATACENTER_DATABASE_TIMEOUT=10
DATACENTER_JWT_SECRET=change-me-in-production
DATACENTER_JWT_EXPIRE_HOURS=72
DATACENTER_JWT_ISSUER=datacenter
DATACENTER_LOG_LEVEL=info
DATACENTER_LOG_OUTPUT=stdout
DATACENTER_DATA_ROOT_DIR=/nfs/data
DATACENTER_BOOTSTRAP_ADMIN_USERNAME=admin
DATACENTER_BOOTSTRAP_ADMIN_PASSWORD=admin123
