# MongoDB配置
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=datacenter

# JWT配置
JWT_SECRET=your-secret-key
JWT_EXPIRATION=24
JWT_REFRESH_EXPIRATION=720

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/app.log
LOG_MAX_SIZE=100
LOG_MAX_BACKUPS=5
LOG_MAX_AGE=30

# 服务器配置
SERVER_HOST=0.0.0.0
SERVER_PORT=8443

# TLS配置
TLS_CERT=cert.pem
TLS_KEY=key.pem
